        "id",
        "group_id",
        "occurrence_ids",
        "canonical_id",
        "decision",
        "reason",
        "algorithm_version",
        "user_override",
        "created_at"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "receiving",
            "archiving",
            "parsing",
            "dedup",
            "credential",
            "planning",
            "generating",
            "merging",
            "validating",
            "saving",
            "registration"
