            "source_access_lost",
            "copy_incomplete",
            "permission_denied",
            "disk_full",
            "path_unavailable",
            "unsafe_archive",
            "parse_failed",
            "auth_failed",
            "quota_exceeded",
            "rate_limited",
            "network_unavailable",
            "provider_unavailable",
            "cancelled",
            "incomplete_coverage",
            "invalid_reference",
            "save_failed",
            "registration_failed",
            "unknown"
