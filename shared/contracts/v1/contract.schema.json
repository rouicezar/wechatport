  "$defs": {
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "original_name": {
          "type": "string"
        },
        "relative_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.(/|$))(?!.*:).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "original_name",
        "relative_path",
        "sha256",
        "byte_count",
        "media_type"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imported": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed_duplicate": {
          "type": "integer",
          "minimum": 0
        },
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "unparsed": {
          "type": "integer",
          "minimum": 0
        },
        "suspected": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "imported",
        "confirmed_duplicate",
        "new",
        "unparsed",
        "suspected"
      ]
    },
    "ready": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "batch_id": {
          "type": "string",
          "format": "uuid"
        },
        "received_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
        },
        "source_channel": {
          "type": "string",
          "enum": [
            "system_share",
            "manual_import"
          ]
        },
        "state": {
          "const": "ready"
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attachment"
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "batch_id",
        "received_at",
        "source_channel",
        "state",
        "attachments"
      ]
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "batch_id": {
          "type": "string",
          "format": "uuid"
        },
        "group_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_entry": {
          "type": "string"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "source_locator": {
          "type": "string",
          "pattern": "^source://[0-9a-f-]{36}/[^/]+/[1-9][0-9]*$"
        },
        "sender_raw": {
          "type": "string"
        },
        "time_raw": {
          "type": "string"
        },
        "time_precision": {
          "type": "string",
          "enum": [
            "second",
            "minute",
            "day",
            "unknown"
          ]
        },
        "interpreted_local_time": {
          "type": "string"
        },
        "interpretation_timezone": {
          "type": "string"
        },
        "text_raw": {
          "type": "string"
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attachment"
          }
        },
        "parse_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "batch_id",
        "group_id",
        "source_entry",
        "ordinal",
        "source_locator",
        "sender_raw",
        "time_raw",
        "time_precision",
        "text_raw",
        "attachments",
        "parse_warnings"
      ]
    },
    "dedup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
