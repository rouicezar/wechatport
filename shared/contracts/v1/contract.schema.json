        "algorithm_version": {
          "type": "string"
        },
        "user_override": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
        },
        "reverses_decision_id": {
          "type": "string",
          "format": "uuid"
        }
